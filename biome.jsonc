{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      // These are in addition to .gitignore
      "**",
      "!**/*.log",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!yarn.lock",
      // Biome's formatter currently erases comments from yaml files
      "!**/*.yaml",
      // Ignore generated artifacts (e.g. TanStack route trees)
      "!**/*.gen.*",
      // Each external-test has its own linting config, following the conventions of its framework
      "!**/external-tests"
    ],
    // 2mb
    "maxSize": 2097152
  },
  "overrides": [
    {
      "includes": [
        "packages/myheader-microfrontend-app/**",
        "demos/basic-nextjs-demo/**",
        "demos/basic-react-router-demo/**",
        "demos/basic-tanstack-demo/**",
        "demos/basic-vite-demo/**"
      ],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["demos/basic-nextjs-demo/**"],
      "linter": {
        "domains": {
          "next": "recommended"
        }
      }
    }
  ],
  "formatter": {
    "formatWithErrors": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "error",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "warn",
        "noEmptyInterface": "error",
        "noRedundantUseStrict": "error"
      },
      "style": {
        "noInferrableTypes": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useImportType": "error",
        "useExportType": "error"
      },
      // "nursery": {
      //   "useImportType": "error",
      //   "useExportType": "error",
      //   "noUnusedImports": "error",
      //   "noNodejsModules": "error"
      // },
      "performance": {
        "noDelete": "warn"
      },
      "complexity": {
        "noForEach": "warn",
        "noStaticOnlyClass": "error",
        "noBannedTypes": "error"
      }
    }
  }
}
