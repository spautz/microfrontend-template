{
  "extends": "../../tsconfig-base.typecheck.json",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedDeclarations": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["*.ts", "src"]
}
