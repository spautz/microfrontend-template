{
  "name": "@spautz/microfrontend-template--basic-tanstack-demo",
  "private": true,
  "description": "Basic UI demo app for the microfrontend SDK, using Tanstack Start",
  "license": "MIT",
  "homepage": "https://github.com/spautz/microfrontend-template/blob/main/demos/basic-tanstack-demo#readme",
  "bugs": "https://github.com/spautz/microfrontend-template/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spautz/microfrontend-template.git",
    "directory": "demos/basic-tanstack-demo"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com"
  },
  "source": "./src/routes/__root.tsx",
  "type": "module",
  "scripts": {
    "____ STANDARD PACKAGE TASKS ________________________________________": "",
    "all": "turbo run pipeline-all",
    "all:ci": "turbo run pipeline-ci --ui=stream",
    "build": "pnpm run build:clean && pnpm run build:main",
    "clean": "pnpm run build:clean && pnpm run test:clean && rimraf --glob ./node_modules/.cache ./.nitro ./.output ./.tanstack ./.turbo ./*.log",
    "dev": "vite dev --port 3003",
    "lint": "biome check --write .",
    "lint:verify": "biome check .",
    "start": "vite preview --port 3003",
    "test:clean": "rimraf ./coverage",
    "test": "pnpm run test:clean       && vitest run --coverage",
    "test:ci": "pnpm run test:clean    && vitest run --coverage --bail 1",
    "test:ui": "pnpm run test:clean    && vitest --ui",
    "test:watch": "pnpm run test:clean && vitest watch --coverage",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "____ BUILD & DEPLOY TASKS __________________________________________": "",
    "build:clean": "rimraf ./dist",
    "build:main": "vite build",
    "build:watch": "pnpm run build:clean && vite build --watch"
  },
  "dependencies": {
    "@spautz/mfeheader-sdk": "workspace:^",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-devtools": "0.9.4",
    "@tanstack/react-router": "1.157.17",
    "@tanstack/react-router-devtools": "1.157.17",
    "@tanstack/react-router-ssr-query": "1.157.17",
    "@tanstack/react-start": "1.157.17",
    "@tanstack/router-plugin": "1.157.17",
    "lucide-react": "0.563.0",
    "nitro": "npm:nitro-nightly@latest",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.1.18",
    "vite-tsconfig-paths": "6.0.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.5.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-vitals": "5.1.0"
  }
}
